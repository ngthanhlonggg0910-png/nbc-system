HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7
ADMIN_ROLE_ID=1

# Optional OneSignal server delivery. Never expose this API key to frontend.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
